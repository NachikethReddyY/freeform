{
	"name": "freeform",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"scripts": {
		"dev": "vite --host localhost --port 5173 --strictPort",
		"dev:container": "vite --host 0.0.0.0 --port 5173 --strictPort",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"mcp": "tsx mcp/server.ts",
		"test:mcp": "tsx mcp/smoke.ts",
		"test:diagrams": "tsx --test worker/diagramProposals.test.ts client/features/diagrams/*.test.ts client/features/diagrams/library/*.test.ts",
		"test:boards": "tsx --test client/features/boards/*.test.ts",
		"test:presentation": "tsx --test client/features/presentation/*.test.ts",
		"test:palette": "tsx --test client/features/commandPalette/*.test.ts"
	},
	"dependencies": {
		"@fontsource/geist-sans": "^5.3.0",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@tldraw/sync": "5.4.2",
		"@tldraw/sync-core": "5.4.2",
		"@tldraw/tlschema": "5.4.2",
		"cloudflare-workers-unfurl": "0.0.9",
		"excalifont": "1.0.0",
		"itty-router": "5.0.18",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-router-dom": "6.28.2",
		"tldraw": "5.4.2",
		"zod": "4.1.8"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.29.1",
		"@types/node": "24.10.4",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"concurrently": "9.1.2",
		"tsx": "4.20.6",
		"typescript": "5.8.3",
		"vite": "8.0.16",
		"wrangler": "4.75.0"
	}
}
